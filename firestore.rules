
rules_version = '2';

// LifeCare Ambulance Service — Firestore security rules.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'admin@lifecare.com' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    function isBookingOwner(doc) {
      return isSignedIn() && (
        doc.data.userId == request.auth.uid ||
        doc.data.user_id == request.auth.uid
      );
    }

    function isBookingDriver(doc) {
      return isSignedIn() && (
        doc.data.driverId == request.auth.uid ||
        doc.data.assigned_driver_uid == request.auth.uid
      );
    }

    function isNotificationOwner(doc) {
      return isSignedIn() && (
        doc.data.userId == request.auth.uid ||
        doc.data.user_id == request.auth.uid
      );
    }

    function isPaymentOwner(doc) {
      return isSignedIn() && (
        doc.data.userId == request.auth.uid ||
        doc.data.user_id == request.auth.uid
      );
    }

    // Booking status lifecycle
    function validBookingTransition() {
      return resource.data.status == request.resource.data.status ||
        (
          resource.data.status == 'pending' &&
          (
            request.resource.data.status == 'accepted' ||
            request.resource.data.status == 'rejected' ||
            request.resource.data.status == 'cancelled'
          )
        ) ||
        (
          resource.data.status == 'accepted' &&
          (
            request.resource.data.status == 'confirmed' ||
            request.resource.data.status == 'paid' ||
            request.resource.data.status == 'rejected' ||
            request.resource.data.status == 'cancelled' ||
            request.resource.data.status == 'expired'
          )
        ) ||
        (
          resource.data.status == 'paid' &&
          request.resource.data.status == 'confirmed'
        ) ||
        (
          resource.data.status == 'confirmed' &&
          request.resource.data.status == 'allocated'
        ) ||
        (
          resource.data.status == 'allocated' &&
          (
            request.resource.data.status == 'completed' ||
            request.resource.data.status == 'cancelled'
          )
        );
    }

    // User profiles
    match /users/{userId} {
      allow read: if isSignedIn() &&
        (request.auth.uid == userId || isAdmin());

      allow create: if isSignedIn() &&
        request.auth.uid == userId;

      allow update: if isSignedIn() &&
        (request.auth.uid == userId || isAdmin());

      allow delete: if isAdmin();
    }

    // Ambulance bookings
    match /bookings/{id} {
      allow read: if isSignedIn() && (
        isBookingOwner(resource) ||
        isBookingDriver(resource) ||
        isAdmin()
      );

      allow create: if isSignedIn() &&
        isBookingOwner(request.resource);

      allow update: if (isAdmin() && validBookingTransition()) ||
        (isBookingOwner(resource) && (
          (resource.data.status == 'allocated' && request.resource.data.status == 'completed') ||
          (resource.data.status == 'accepted' && (request.resource.data.status == 'confirmed' || request.resource.data.status == 'paid' || request.resource.data.paymentStatus == 'paid')) ||
          (request.resource.data.paymentStatus == 'paid')
        ));

      allow delete: if isAdmin();
    }

    // Pickup verification PINs
    match /booking_pins/{id} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.user_id == request.auth.uid ||
        isAdmin()
      );

      allow write: if false;
    }

    // Ambulances
    match /ambulances/{id} {
      allow read: if true;
      allow write: if isAdmin() || isSignedIn();
    }

    // Drivers
    match /drivers/{id} {
      allow read: if true;
      allow write: if isAdmin() || isSignedIn();
    }

    // Hospitals
    match /hospitals/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Emergency alerts
    match /alerts/{id} {
      allow create: if isSignedIn() && (
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.user_id == request.auth.uid
      );

      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.user_id == request.auth.uid ||
        isAdmin()
      );

      allow update: if false;
      allow delete: if false;
    }

    // Notifications
    match /notifications/{id} {
      allow read: if isSignedIn() &&
        (isNotificationOwner(resource) || (resource.data.userId == 'admin' && isAdmin()) || isAdmin());

      allow create: if isSignedIn() &&
        (isNotificationOwner(request.resource) || request.resource.data.userId == 'admin' || isAdmin());

      allow update: if isAdmin() ||
        (isSignedIn() && isNotificationOwner(resource) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'updatedAt', 'updated_at']));

      allow delete: if isAdmin();
    }

    // Emergency contacts
    match /emergency_contacts/{id} {
      allow read: if isSignedIn() &&
        (resource.data.owner_uid == request.auth.uid || isAdmin());

      allow create: if isSignedIn() &&
        request.resource.data.owner_uid == request.auth.uid;

      allow update, delete: if isSignedIn() &&
        resource.data.owner_uid == request.auth.uid;
    }

    // Razorpay payment records
    match /payments/{id} {
      allow read: if isSignedIn() &&
        (isPaymentOwner(resource) || isAdmin());

      allow create: if isSignedIn() &&
        (isPaymentOwner(request.resource) || isAdmin());

      allow update, delete: if isAdmin();
    }

    // Application & Dispatch Settings
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
