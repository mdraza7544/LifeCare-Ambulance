# Firebase client SDK config — the web API key is a public identifier and is
# safe for the browser bundle. Get these values from:
# Firebase Console > Project settings > Your apps > SDK setup and configuration.
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# EmailJS browser keys (public by design; restrict the service in the EmailJS dashboard)
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# Google Maps JavaScript & Places API Key
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
GOOGLE_MAPS_KEY=your_google_maps_api_key

# Third-party Hospitals API endpoint
VITE_HOSPITALS_API_URL=https://wibest.in/data/json/hospitals.json

# Payment Mode:
# "demo"     - Interactive Razorpay-like simulated checkout modal (no API keys required).
# "razorpay" - Real/Test Razorpay Gateway via Cloud Functions (requires Razorpay credentials).
VITE_PAYMENT_MODE=demo

# Cloud Functions Emulator (set 'false' to use production functions when on localhost)
# VITE_FUNCTIONS_EMULATOR=false
