# Cloud Functions runtime config — COPY to `functions/.env` and fill in.
# NEVER commit the real file. For production prefer Firebase secret params:
#   firebase functions:secrets:set TWILIO_AUTH_TOKEN
# (see FIREBASE_SETUP.md)

# ---- Twilio (emergency SMS) ----
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+15005550006

# ---- EmailJS (emergency email, server-side REST send) ----
EMAILJS_SERVICE_ID=service_your_id
EMAILJS_TEMPLATE_ID=template_your_id
EMAILJS_PUBLIC_KEY=your_emailjs_public_key
EMAILJS_PRIVATE_KEY=your_emailjs_private_key
EMAILJS_FROM_NAME=LifeCare Ambulance Service

# ---- Razorpay (real-time payments; server-side only) ----
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Webhook signature secret (Razorpay Dashboard > Settings > Webhooks).
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ---- Bootstrap admins (comma-separated emails allowed to run setUserRole) ----
ADMIN_EMAILS=you@example.com

# ---- Booking pickup verification PINs ----
# Server-side pepper mixed into the PIN hash. Set a long random string in
# production (firebase functions:secrets:set PIN_PEPPER). A default is used if
# unset so local development works, but override it before deploying.
PIN_PEPPER=replace-with-a-long-random-secret